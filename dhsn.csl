<?xml version="1.0" encoding="utf-8"?>
<!-- Citation and bibliography style implementing the DHSN Dresden Styleguide -->
<!-- Repeated citations are replaced with "ebenda", the template places citations in footnotes -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="de-DE" demote-non-dropping-particle="never">
  <info>
    <title>DHSN Dresden (baarticle)</title>
    <id>https://github.com/xNycrofox/dhsn-typst-template/dhsn</id>
    <link href="https://github.com/xNycrofox/dhsn-typst-template" rel="documentation"/>
    <category citation-format="note"/>
    <category field="generic-base"/>
    <updated>2026-10-13T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="et-al">et al.</term>
      <term name="ibid">ebenda</term>
    </terms>
  </locale>
  <!-- family name is put before the first name, names are separated by a slash -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="/"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="/"/>
      <substitute>
        <names variable="editor" suffix=" (Hrsg.)"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor" suffix=" (Hrsg.)">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="/"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued" prefix="(" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="label">
    <group delimiter=" ">
      <text macro="author"/>
      <text macro="year"/>
    </group>
  </macro>
  <macro name="locator">
    <text variable="locator" prefix="S. "/>
  </macro>
  <macro name="title">
    <choose>
      <if variable="author editor" match="any">
        <text variable="title" font-style="italic"/>
      </if>
    </choose>
  </macro>
  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=" ">
          <text value="in:"/>
          <text variable="container-title" font-style="italic"/>
          <group delimiter=".">
            <text variable="volume"/>
            <text variable="issue"/>
          </group>
        </group>
      </if>
      <else-if variable="container-title">
        <group delimiter=" ">
          <text value="in:"/>
          <group delimiter=", ">
            <text macro="editor"/>
            <text variable="container-title" font-style="italic"/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text value="Auflage"/>
        </group>
      </if>
      <else>
        <text variable="edition" suffix=" Auflage"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="url">
    <group delimiter=", ">
      <text variable="URL" prefix="in: "/>
      <date variable="accessed" prefix="(" suffix=")">
        <date-part name="day" form="numeric-leading-zeros" suffix="."/>
        <date-part name="month" form="numeric-leading-zeros" suffix="."/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <!-- add internal document notice to unpublished -->
  <macro name="internal">
    <choose>
      <if type="manuscript">
        <text value="internes Dokument"/>
      </if>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="ibid">
          <group delimiter=", ">
            <text term="ibid"/>
            <text macro="locator"/>
          </group>
        </if>
        <else>
          <group delimiter=", ">
            <text macro="label"/>
            <text macro="locator"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=", ">
        <group delimiter=": ">
          <group delimiter=" ">
            <text macro="author-bib"/>
            <text macro="year"/>
          </group>
          <text macro="title"/>
        </group>
        <text macro="container"/>
        <text macro="edition"/>
        <text macro="publisher"/>
        <text macro="pages"/>
        <text macro="url"/>
        <text macro="internal"/>
      </group>
    </layout>
  </bibliography>
</style>
